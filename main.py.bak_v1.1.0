class ModernCard(ctk.CTkFrame):
    def __init__(self, master, **kwargs):
        super().__init__(master, fg_color=("gray95", "gray15"), corner_radius=12, border_width=1, border_color=("gray80", "gray25"), **kwargs)


class StatusBadge(ctk.CTkLabel):
    COLORS = {
        "success": ("#2e7d32", "#4caf50"),
        "error": ("#c62828", "#ef5350"),
        "warning": ("#ef6c00", "#ffa726"),
        "info": ("#1565c0", "#42a5f5"),
        "testing": ("#6a1b9a", "#ab47bc"),
    }
    def __init__(self, master, status: str, text: str = "", **kwargs):
        fg = self.COLORS.get(status, self.COLORS["info"])[1]
        super().__init__(master, text=text or status.capitalize(), fg_color=fg, text_color="white", corner_radius=12, font=ctk.CTkFont(size=11, weight="bold"), padx=10, pady=4, **kwargs)


class ModelRow(ctk.CTkFrame):
    def __init__(self, master, model_data: Dict, router_name: str, on_toggle=None, **kwargs):
        super().__init__(master, fg_color="transparent", **kwargs)
        self.model_data = model_data
        self.router_name = router_name
        self.on_toggle = on_toggle
        self.selected = False
        
        self.grid_columnconfigure(1, weight=1)
        
        self.checkbox = ctk.CTkCheckBox(self, text="", width=24, height=24, command=self._on_toggle)
        self.checkbox.grid(row=0, column=0, padx=(12, 8), pady=8)
        
        info_frame = ctk.CTkFrame(self, fg_color="transparent")
        info_frame.grid(row=0, column=1, sticky="ew", padx=8, pady=8)
        info_frame.grid_columnconfigure(0, weight=1)
        
        self.id_label = ctk.CTkLabel(info_frame, text=model_data.get('id', ''), font=ctk.CTkFont(size=12, family="monospace"), anchor="w")
        self.id_label.grid(row=0, column=0, sticky="ew")
        
        name = model_data.get('name', '') or model_data.get('id', '')
        self.name_label = ctk.CTkLabel(info_frame, text=name, font=ctk.CTkFont(size=11), text_color=("gray40", "gray60"), anchor="w")
        self.name_label.grid(row=1, column=0, sticky="ew")
        
        mtype = "Combo" if ModelAnalyzer.is_combo(model_data.get('id', ''), name) else ("Free" if ModelAnalyzer.is_free_model(model_data.get('id', ''), name) else "Paid")
        badge_color = {"Combo": ("#6a1b9a", "#ab47bc"), "Free": ("#2e7d32", "#4caf50"), "Paid": ("#c62828", "#ef5350")}[mtype][1]
        self.type_badge = ctk.CTkLabel(self, text=mtype, fg_color=badge_color, text_color="white", corner_radius=8, font=ctk.CTkFont(size=10, weight="bold"), padx=10, pady=2)
        self.type_badge.grid(row=0, column=2, padx=(8, 12), pady=8)
    
    def _on_toggle(self):
        self.selected = self.checkbox.get() == 1
        if self.on_toggle:
            self.on_toggle(self)


class RouterConfigCard(ctk.CTkFrame):
