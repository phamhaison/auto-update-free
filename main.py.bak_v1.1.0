# ==================== CONFIGURATION ====================
ctk.set_appearance_mode("system")
ctk.set_default_color_theme("blue")

APP_NAME = "Auto-Update-Free"
APP_VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "auto-update-free"
CONFIG_FILE = CONFIG_DIR / "config.json"
OPENCODE_CONFIG = Path.home() / ".config" / "opencode" / "opencode.jsonc"


# ==================== UTILITY CLASSES ====================
class ConfigManager:
    DEFAULT_CONFIG = {
        "9router": {
            "endpoint": "http://localhost:20128/v1",
            "api_key": "sk-921042c36766f489-qjn67j-65503176"
        },
        "omnirouter": {
            "endpoint": "http://son-server.tail8cd54f.ts.net:20128/v1",
            "api_key": "sk-c8231f142e2df954-6df89e-431c37d5"
        }
    }
    
    @classmethod
    def load(cls) -> Dict:
        if CONFIG_FILE.exists():
            try:
                with open(CONFIG_FILE, 'r') as f:
                    config = json.load(f)
                merged = cls.DEFAULT_CONFIG.copy()
                merged.update(config)
                for key in cls.DEFAULT_CONFIG:
                    if key not in merged:
                        merged[key] = cls.DEFAULT_CONFIG[key]
                    elif isinstance(cls.DEFAULT_CONFIG[key], dict):
                        for subkey in cls.DEFAULT_CONFIG[key]:
                            if subkey not in merged[key]:
                                merged[key][subkey] = cls.DEFAULT_CONFIG[key][subkey]
                return merged
            except Exception:
                pass
        return cls.DEFAULT_CONFIG.copy()
    
    @classmethod
    def save(cls, config: Dict) -> bool:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            with open(CONFIG_FILE, 'w') as f:
                json.dump(config, f, indent=2)
            return True
        except Exception as e:
            print(f"Failed to save config: {e}")
            return False


class APIClient:
    def __init__(self, endpoint: str, api_key: str, timeout: int = 30):
        self.endpoint = endpoint.rstrip('/')
        self.api_key = api_key
        self.timeout = timeout
        self.session = requests.Session()
        self.session.headers.update({
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        })
    
    def health_check(self) -> bool:
        try:
            health_url = self.endpoint.replace('/v1', '') + '/api/health'
            resp = self.session.get(health_url, timeout=10)
            if resp.status_code == 200:
                return resp.json().get('status') == 'ok'
        except Exception:
            pass
        try:
            resp = self.session.get(f"{self.endpoint}/models", timeout=10)
            return resp.status_code == 200
        except Exception:
            return False
    
    def get_models(self) -> List[Dict]:
        try:
            resp = self.session.get(f"{self.endpoint}/models", timeout=self.timeout)
            if resp.status_code == 200:
                return resp.json().get('data', [])
        except Exception as e:
            print(f"Error fetching models: {e}")
        return []
    
    def test_model(self, model_id: str) -> bool:
        try:
            resp = self.session.post(
                f"{self.endpoint}/chat/completions",
                json={"model": model_id, "messages": [{"role": "user", "content": "Hi"}], "max_tokens": 5},
                timeout=30
            )
            return resp.status_code == 200
        except Exception:
            return False


class OpenCodeConfigManager:
    @classmethod
    def load(cls) -> Dict:
        if not OPENCODE_CONFIG.exists():
            return {"$schema": "https://opencode.ai/config.json", "mcp": {}, "provider": {}}
        try:
            raw = OPENCODE_CONFIG.read_text()
            lines = raw.split('\n')
            clean = []
            for line in lines:
                idx = line.find('//')
                if idx >= 0:
                    in_str = False
                    for i, ch in enumerate(line):
                        if ch == '"' and (i == 0 or line[i-1] != '\\'):
                            in_str = not in_str
                        if i == idx and not in_str:
                            line = line[:idx]
                            break
                clean.append(line)
            text = '\n'.join(clean)
            text = __import__('re').sub(r',\s*([}\]])', r'\1', text)
            return json.loads(text) if text.strip() else {}
        except Exception as e:
            print(f"Error loading OpenCode config: {e}")
            return {"$schema": "https://opencode.ai/config.json", "mcp": {}, "provider": {}}
    
    @classmethod
    def save(cls, config: Dict) -> bool:
        try:
            OPENCODE_CONFIG.parent.mkdir(parents=True, exist_ok=True)
            if OPENCODE_CONFIG.exists():
                backup = OPENCODE_CONFIG.with_suffix(f".jsonc.bak.{int(time.time())}")
                OPENCODE_CONFIG.rename(backup)
            with open(OPENCODE_CONFIG, 'w') as f:
                json.dump(config, f, indent=2, ensure_ascii=False)
                f.write('\n')
            return True
        except Exception as e:
            print(f"Error saving OpenCode config: {e}")
            return False


class ModelAnalyzer:
    FREE_KEYWORDS = ['free', 'gratis', 'no-cost', 'freemium', ':free']
    COMBO_KEYWORDS = ['combo', 'gateway', 'auto', 'router', 'link', 'pool', 'bazaar', 'kilo', 'ollama', 'openrouter', 'pollinations', 'poolside', 'bazaarlink']
    
    @classmethod
    def is_free_model(cls, model_id: str, model_name: str = "") -> bool:
        text = f"{model_id} {model_name}".lower()
        return any(kw in text for kw in cls.FREE_KEYWORDS)
    
    @classmethod
    def is_combo(cls, model_id: str, model_name: str = "") -> bool:
        text = f"{model_id} {model_name}".lower()
        return any(kw in text for kw in cls.COMBO_KEYWORDS)
    
    @classmethod
    def categorize_models(cls, models: List[Dict]) -> Dict[str, List[Dict]]:
        combos, free_models, other = [], [], []
        for model in models:
            model_id = model.get('id', '')
            model_name = model.get('name', '') or model.get('id', '')
            if cls.is_combo(model_id, model_name):
                combos.append(model)
            elif cls.is_free_model(model_id, model_name):
                free_models.append(model)
            else:
                other.append(model)
        return {'combos': combos, 'free_models': free_models, 'other': other}


